{
  "name": "qday-readiness",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Q-Day readiness audit for QoreChain accounts: scan, score, fix, and attest with one hybrid-signed transaction.",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "start": "node server.mjs",
    "qday": "tsx src/cli/qday.ts",
    "scaffold:contracts": "create-qorechain-dapp contracts --template evm-solidity --network testnet --no-install",
    "compile:contracts": "npm --prefix contracts run compile",
    "test": "tsx --test test/*.test.ts && node --test test/*.test.mjs",
    "cf:dev": "wrangler dev --ip 127.0.0.1",
    "deploy": "./deploy.sh"
  },
  "dependencies": {
    "@cosmjs/encoding": "^0.39.0",
    "@cosmjs/proto-signing": "^0.39.0",
    "@cosmjs/stargate": "^0.39.0",
    "@qorechain/evm": "^0.13.0",
    "@qorechain/qoresign": "^0.2.0",
    "@qorechain/qorex-rainbowkit": "^0.1.0",
    "@qorechain/qorex-types": "^0.1.0",
    "@qorechain/sdk": "^0.13.0",
    "@rainbow-me/rainbowkit": "^2.2.11",
    "@tanstack/react-query": "^5.59.0",
    "cosmjs-types": "^0.11.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "viem": "2.57.5",
    "wagmi": "^2.19.5"
  },
  "devDependencies": {
    "@qorechain/qorex-wallet-mock": "^0.1.0",
    "@types/node": "^26.6.6",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.0",
    "create-qorechain-dapp": "0.13.1",
    "tsx": "^4.23.15",
    "typescript": "^5.6.3",
    "vite": "^5.4.0",
    "wrangler": "4.160.0"
  },
  "license": "MIT"
}

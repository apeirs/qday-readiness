{
  // Cloudflare Worker for the hosted demo: the built app (dist/) plus the read-only chain gateway.
  // Deploy with ./deploy.sh. No KV, D1, secrets or other resources: just this one Worker.
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "qday-readiness",
  "main": "worker/index.mjs",
  "compatibility_date": "2026-11-01",
  "workers_dev": true,
  "preview_urls": false,
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    // The app is a single page; ?a= and ?tx= deep links all load index.html.
    "not_found_handling": "single-page-application",
    // Only the gateway runs code; everything else is served straight from the asset store.
    "run_worker_first": ["/chain/*"]
  }
}
